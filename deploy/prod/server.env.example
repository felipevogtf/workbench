# Plantilla de variables del servidor en producción. Copiar a `server.env` (no se versiona) y completar.

PORT=3000

# Postgres existente del host (servicio `postgres` en la red git_repos_default)
DATABASE_URL=postgresql://workbench:CAMBIAR@postgres:5432/workbench

# --- Plane (módulo tasks) ---
PLANE_API_URL=CAMBIAR
PLANE_API_KEY=CAMBIAR
PLANE_WORKSPACE_SLUG=CAMBIAR
PLANE_USER_ID=CAMBIAR

# --- Revisión de PRs ---
# Carpeta de las revisiones (.md); es el volumen `reviews`.
REVIEWS_DIR=/data/reviews

# Claude con tu suscripción: ejecuta `claude setup-token` en tu máquina y pega el token.
# No definas ANTHROPIC_API_KEY: si está presente, Claude cobra por consumo de API.
CLAUDE_CODE_OAUTH_TOKEN=

# Bitbucket: las tres juntas o ninguna.
BITBUCKET_EMAIL=
BITBUCKET_TOKEN=
BITBUCKET_WORKSPACE=
# Opcional: repos separados por comas (vacío = todos los del workspace)
BITBUCKET_REPOS=

# GitHub (opcional)
GITHUB_TOKEN=

# Opcionales (vacío = valor por defecto)
REVIEW_CONCURRENCY=1
PR_SYNC_CRON=
# Sync con Plane (proyectos y tareas); vacío = cada hora
TASKS_SYNC_CRON=
AGENT_TIMEOUT_MS=

# Proveedores de IA adicionales (opcionales; también se pueden iniciar sesion dentro del contenedor)
# Copilot CLI: token fine-grained de GitHub con el permiso "Copilot Requests"
COPILOT_TOKEN=
# Antigravity CLI: API key de Gemini (sin ella usa la sesion iniciada con agy)
GEMINI_API_KEY=
# Proveedores habilitados, separados por comas: claude,copilot,antigravity (vacio = todos)
AGENT_PROVIDERS=
# Modelos que ofrece cada proveedor, separados por comas (vacio = los de fabrica)
CLAUDE_MODELS=
COPILOT_MODELS=
ANTIGRAVITY_MODELS=
