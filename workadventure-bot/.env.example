# Copy to .env and edit. Lines starting with # are ignored. Do not leave a variable with an empty value (delete or comment it).
# A variable already set in the shell wins over this file, e.g.:  $env:WANDER="0"; npm start

# ---- Room (required) ----
WA_MAP_URL=https://play.workadventu.re/@/team-php/team-php/startup

# ---- Who the bot is ----
# WA_GENDER=mujer              # mujer | hombre (default: random; name, skin and voice follow it, see config/characters.json)
# WA_BOT_NAME=Gaspar IA        # default: random name + "IA" (WorkAdventure cuts names at 10 characters)
# WA_RANDOM_SKIN=0             # 0 keeps the default skin

# ---- Behaviour ----
# HEADED=1                     # show the browser window
# WANDER=0                     # stand still
# RUN_SECONDS=120              # stop by itself after N seconds
# WA_ZONES=config/zones.json   # forbidden zones file
# WA_MAP=0                     # do not read the room map (walls, furniture, areas); the bot then walks blind as before
# WA_MAP_FURNITURE=0           # read walls only, ignore the collision grids of the furniture
WA_POS_LOG=1                   # write every tile it walks to into logs/<run>/movement.log

# ---- Voice (speaking) ----
# WA_VOICE=0                   # text only, no speaking and no listening
# WA_VOICE_NAME=edge:es-CL-LorenzoNeural   # or es_MX-claude-high / es_MX-ald-medium (local Piper)
# WA_FILLER=1                  # spoken fillers ("mmm, a ver") while the LLM thinks (off by default)
# WA_EDGE_RATE=1.0             # speed of Microsoft voices
# WA_EDGE_ATTEMPTS=5           # retries when the Microsoft service answers 429
# WA_PIPER_SPEED=0.9
# WA_PIPER_NOISE=0.8
# WA_PIPER_NOISE_W=0.95

# ---- Listening ----
# WA_LISTEN=0                  # do not transcribe what people say
# WA_STT_MODEL=Xenova/whisper-small
# WA_VAD_THRESHOLD=0.012       # raise if it hears noise, lower if it misses quiet voices
# WA_VAD_END_MS=1100           # silence that ends a sentence

# ---- Talking over the bot ----
# WA_BARGE_IN=0                # 0 = the bot always finishes its sentence (everything said meanwhile is ignored)
# WA_BARGE_IN_RMS=0.04         # level that counts as talking over it; raise it if its own echo cuts it off (headphones avoid that)
# WA_ECHO_TAIL_MS=1200         # audio ignored this long after the bot stops speaking (its echo); lower = you can answer sooner
# WA_CHAT_POLL_MS=600          # how often the chat loop looks for something new

# ---- LLM (GitHub Copilot CLI) ----
# WA_MODEL=auto
# COPILOT_TOKEN=               # (set the value, or remove the line)
# COPILOT_JS=C:\Program Files\nodejs\node_modules\@github\copilot\npm-loader.js

# ---- Audio capture experiments (see plans/ and README) ----
WA_TAP_CYCLE=0                 # 1 = switch capture method every 30 s to compare them (disturbs real conversations)
# WA_TAP=variant=own-audible-keep   # fixed capture method: own-muted | own-audible | own-audible-keep | app-element ; rate=0 = native sample rate
# WA_DEBUG_AUDIO=1             # save every heard segment in out/debug-audio/ (also turns the cycle on unless WA_TAP_CYCLE=0)
# WA_SELFTEST=1                # play a test tone through the capture chain at start-up

# ---- Chat selectors (only if WorkAdventure changes its UI) ----
# WA_CHAT_MSG_SELECTOR=.message-bubble
# WA_CHAT_INPUT_SELECTOR=div.message-input

# ---- Logs ----
# WA_LOG_CONSOLE=system,conversation,latency   # channels shown in the terminal; "all" shows everything (movement, audio...)
# WA_LOG_FILES=0                                # do not write log files
# WA_LOG_DIR=logs
